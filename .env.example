# PayPal Sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODEL=poolside/laguna-s-2.1:free

# Model spend limits. The free tier is 50 requests a day shared by every
# visitor, so the public link caps both what one visitor may ask for and what
# the account may spend in a day. Exceeding either returns the template
# explanation, which is still correct and still cites its rules.
MODEL_EXPLAINS_PER_WINDOW=6
MODEL_WINDOW_MINUTES=10
MODEL_DAILY_REQUEST_CAP=44